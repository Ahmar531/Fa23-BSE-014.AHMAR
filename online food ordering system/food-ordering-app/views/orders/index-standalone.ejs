<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders - FoodHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
            color: #212121;
        }
        .navbar {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            box-shadow: 0 8px 32px rgba(215, 15, 100, 0.25);
            padding: 18px 0;
        }
        .navbar-brand {
            font-size: 2rem;
            font-weight: 900;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        .navbar-brand i {
            color: #ffc107;
            font-size: 2.2rem;
            margin-right: 10px;
        }
        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            padding: 10px 20px !important;
            border-radius: 12px;
        }
        .nav-link:hover { background: rgba(255,255,255,0.2); }
        .btn-primary {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            color: #ffffff;
            font-weight: 700;
            padding: 14px 35px;
            border-radius: 50px;
            border: none;
            box-shadow: 0 10px 30px rgba(215, 15, 100, 0.4);
        }
        .btn-primary:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(215, 15, 100, 0.5);
        }
        .card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            transition: all 0.5s;
            margin-bottom: 30px;
        }
        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 60px rgba(215, 15, 100, 0.25);
        }
        .card-header {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            color: #ffffff;
            font-weight: 700;
            border-radius: 24px 24px 0 0 !important;
            padding: 20px 25px;
        }
        .text-gradient {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
        .badge {
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 700;
        }
        .stat-card {
            background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
            padding: 30px;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        footer {
            background: linear-gradient(135deg, #212121 0%, #1a1a1a 100%);
            color: #ffffff;
            padding: 60px 0 35px;
            margin-top: 100px;
        }
        footer strong {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="bi bi-shop"></i> FoodHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(255,255,255,0.5);">
                <span class="navbar-toggler-icon" style="filter: brightness(0) invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/menu-items"><i class="bi bi-grid"></i> Menu</a></li>
                    <li class="nav-item"><a class="nav-link" href="/orders"><i class="bi bi-bag-check"></i> Orders</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-3 fw-bold text-gradient">Order Management</h1>
                <p class="lead text-muted">View and manage all your orders</p>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-8">
                <span class="badge bg-primary" style="font-size: 1rem; padding: 10px 20px;">
                    <i class="bi bi-bag-check"></i> <%= orders.length %> Total Orders
                </span>
            </div>
            <div class="col-md-4 text-end">
                <a href="/orders/create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> New Order
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <% if (orders.length === 0) { %>
                <div class="card">
                    <div class="card-body text-center p-5">
                        <i class="bi bi-inbox" style="font-size: 4rem; color: #d70f64;"></i>
                        <h4 class="mt-3">No orders yet</h4>
                        <p class="text-muted">Start by creating your first order!</p>
                        <a href="/orders/create" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-circle"></i> Create First Order
                        </a>
                    </div>
                </div>
                <% } else { %>
                    <% orders.forEach(order => { %>
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-receipt"></i> Order #<%= order.id %></span>
                            <% 
                            let badgeClass = 'bg-warning';
                            if (order.status === 'delivered') badgeClass = 'bg-success';
                            if (order.status === 'cancelled') badgeClass = 'bg-danger';
                            if (order.status === 'confirmed') badgeClass = 'bg-info';
                            %>
                            <span class="badge <%= badgeClass %>"><%= order.status.toUpperCase() %></span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-2"><strong><i class="bi bi-person"></i> Customer:</strong> <%= order.customer_name %></p>
                                    <p class="mb-2"><strong><i class="bi bi-telephone"></i> Phone:</strong> <%= order.customer_phone %></p>
                                    <p class="mb-2"><strong><i class="bi bi-envelope"></i> Email:</strong> <%= order.customer_email %></p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-2"><strong><i class="bi bi-calendar"></i> Date:</strong> <%= new Date(order.created_at).toLocaleDateString() %></p>
                                    <p class="mb-2"><strong><i class="bi bi-cash"></i> Total:</strong> <span style="color: #d70f64; font-weight: 900; font-size: 1.3rem;">$<%= order.total_amount.toFixed(2) %></span></p>
                                </div>
                            </div>
                            <hr>
                            <p class="mb-2"><strong><i class="bi bi-geo-alt"></i> Delivery Address:</strong></p>
                            <p class="text-muted"><%= order.delivery_address %></p>
                        </div>
                    </div>
                    <% }); %>
                <% } %>
            </div>

            <div class="col-lg-4">
                <div class="stat-card">
                    <h5 class="fw-bold mb-4"><i class="bi bi-bar-chart"></i> Order Statistics</h5>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Pending</span>
                        <span class="badge bg-warning"><%= orders.filter(o => o.status === 'pending').length %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Confirmed</span>
                        <span class="badge bg-info"><%= orders.filter(o => o.status === 'confirmed').length %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Delivered</span>
                        <span class="badge bg-success"><%= orders.filter(o => o.status === 'delivered').length %></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><strong>Total Orders</strong></span>
                        <span class="badge" style="background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);"><%= orders.length %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <p class="mb-2"><strong>FoodHub</strong> - Your Favorite Food Ordering Platform</p>
            <p class="mb-0">© 2024 Food Ordering System | Web Development Course Project</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
