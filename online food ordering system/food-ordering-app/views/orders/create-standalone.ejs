<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Order - FoodHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
            color: #212121;
        }
        .navbar {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            box-shadow: 0 8px 32px rgba(215, 15, 100, 0.25);
            padding: 18px 0;
        }
        .navbar-brand {
            font-size: 2rem;
            font-weight: 900;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        .navbar-brand i { color: #ffc107; font-size: 2.2rem; margin-right: 10px; }
        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            padding: 10px 20px !important;
            border-radius: 12px;
        }
        .nav-link:hover { background: rgba(255,255,255,0.2); }
        .form-card {
            background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
            padding: 50px;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
        }
        .form-control, .form-select {
            border: 3px solid #eeeeee;
            border-radius: 16px;
            padding: 16px 20px;
            transition: all 0.4s;
            font-weight: 500;
        }
        .form-control:focus, .form-select:focus {
            border-color: #d70f64;
            box-shadow: 0 0 0 6px rgba(215, 15, 100, 0.15);
            outline: none;
        }
        .form-floating > label {
            color: #616161;
            font-weight: 600;
            padding-left: 20px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            color: #ffffff;
            font-weight: 700;
            padding: 16px 40px;
            border-radius: 50px;
            border: none;
            box-shadow: 0 10px 30px rgba(215, 15, 100, 0.4);
            width: 100%;
            font-size: 1.1rem;
        }
        .btn-primary:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(215, 15, 100, 0.5);
        }
        .btn-outline-secondary {
            border: 2px solid #616161;
            color: #616161;
            font-weight: 700;
            padding: 14px 35px;
            border-radius: 50px;
        }
        .text-gradient {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
        .menu-preview {
            background: #ffffff;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }
        footer {
            background: linear-gradient(135deg, #212121 0%, #1a1a1a 100%);
            color: #ffffff;
            padding: 60px 0 35px;
            margin-top: 100px;
        }
        footer strong {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="bi bi-shop"></i> FoodHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(255,255,255,0.5);">
                <span class="navbar-toggler-icon" style="filter: brightness(0) invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/menu-items"><i class="bi bi-grid"></i> Menu</a></li>
                    <li class="nav-item"><a class="nav-link" href="/orders"><i class="bi bi-bag-check"></i> Orders</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        <div class="row mb-4">
            <div class="col">
                <a href="/orders" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5">
                    <h1 class="display-4 fw-bold text-gradient">Place Your Order</h1>
                    <p class="lead text-muted">Fill in your details to complete the order</p>
                </div>

                <div class="form-card">
                    <form method="POST" action="/orders">
                        <h5 class="fw-bold mb-4"><i class="bi bi-person"></i> Customer Information</h5>
                        
                        <div class="form-floating mb-4">
                            <input type="text" class="form-control" id="customer_name" name="customer_name" placeholder="Full Name" required>
                            <label for="customer_name"><i class="bi bi-person"></i> Full Name</label>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="customer_email" name="customer_email" placeholder="Email" required>
                                    <label for="customer_email"><i class="bi bi-envelope"></i> Email</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="tel" class="form-control" id="customer_phone" name="customer_phone" placeholder="Phone" required>
                                    <label for="customer_phone"><i class="bi bi-telephone"></i> Phone</label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <textarea class="form-control" id="delivery_address" name="delivery_address" placeholder="Delivery Address" style="height: 100px" required></textarea>
                            <label for="delivery_address"><i class="bi bi-geo-alt"></i> Delivery Address</label>
                        </div>
                        
                        <hr class="my-4">
                        
                        <h5 class="fw-bold mb-4"><i class="bi bi-cart"></i> Order Details</h5>
                        
                        <% if (selectedItem) { %>
                        <div class="alert alert-success" style="border-radius: 16px; border: none; background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);">
                            <div class="d-flex align-items-center">
                                <img src="<%= selectedItem.image_url %>" alt="<%= selectedItem.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 12px; margin-right: 15px;">
                                <div>
                                    <strong><i class="bi bi-check-circle"></i> Selected Item:</strong> <%= selectedItem.name %><br>
                                    <span style="color: #00c853; font-weight: 700; font-size: 1.2rem;">$<%= selectedItem.price.toFixed(2) %></span>
                                </div>
                            </div>
                        </div>
                        <% } %>
                        
                        <div class="form-floating mb-4">
                            <input type="number" class="form-control" id="total_amount" name="total_amount" placeholder="Total Amount" step="0.01" value="<%= selectedItem ? selectedItem.price : '25.99' %>" required>
                            <label for="total_amount"><i class="bi bi-cash"></i> Total Amount ($)</label>
                            <div class="form-text">Enter the total order amount</div>
                        </div>
                        
                        <div class="alert alert-info" style="border-radius: 16px; border: none;">
                            <i class="bi bi-info-circle"></i> <strong>Note:</strong> Your order will be confirmed shortly after submission. You'll receive updates via email and SMS.
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Place Order
                        </button>
                    </form>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="menu-preview">
                    <h6 class="fw-bold mb-3"><i class="bi bi-grid"></i> Available Menu Items</h6>
                    <% menuItems.slice(0, 3).forEach(item => { %>
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <img src="<%= item.image_url %>" alt="<%= item.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 12px; margin-right: 15px;">
                        <div>
                            <div class="fw-bold"><%= item.name %></div>
                            <div style="color: #d70f64; font-weight: 700;">$<%= item.price.toFixed(2) %></div>
                        </div>
                    </div>
                    <% }); %>
                    <a href="/menu-items" class="btn btn-sm btn-outline-secondary w-100 mt-2">
                        View Full Menu
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <p class="mb-2"><strong>FoodHub</strong> - Your Favorite Food Ordering Platform</p>
            <p class="mb-0">© 2024 Food Ordering System | Web Development Course Project</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
