<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <img src="<%= item.image_url %>" class="card-img-top" alt="<%= item.name %>" style="max-height: 400px; object-fit: cover;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="card-title"><%= item.name %></h2>
                            <span class="badge bg-secondary"><%= item.category %></span>
                            <% if (item.is_available) { %>
                                <span class="badge bg-success">Available</span>
                            <% } else { %>
                                <span class="badge bg-danger">Out of Stock</span>
                            <% } %>
                        </div>
                        <h2 class="text-primary">$<%= item.price.toFixed(2) %></h2>
                    </div>
                    
                    <hr>
                    
                    <h5>Description</h5>
                    <p class="text-muted"><%= item.description %></p>
                    
                    <hr>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Category:</strong> <%= item.category %></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Price:</strong> $<%= item.price.toFixed(2) %></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Status:</strong> 
                                <% if (item.is_available) { %>
                                    <span class="text-success">Available</span>
                                <% } else { %>
                                    <span class="text-danger">Out of Stock</span>
                                <% } %>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Item ID:</strong> #<%= item.id %></p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex gap-2">
                        <a href="/menu-items" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Menu
                        </a>
                        <a href="/menu-items/<%= item.id %>/edit" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete "<%= item.name %>"?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form action="/menu-items/<%= item.id %>?_method=DELETE" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
