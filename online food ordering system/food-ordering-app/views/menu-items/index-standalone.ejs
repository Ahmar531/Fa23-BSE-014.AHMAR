<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Items - FoodHub</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        /* FOODPANDA PREMIUM DESIGN */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
            color: #212121;
            min-height: 100vh;
        }
        
        /* PINK GRADIENT NAVBAR */
        .navbar {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            box-shadow: 0 8px 32px rgba(215, 15, 100, 0.25);
            padding: 18px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .navbar-brand {
            font-size: 2rem;
            font-weight: 900;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        
        .navbar-brand i {
            color: #ffc107;
            font-size: 2.2rem;
            margin-right: 10px;
        }
        
        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            padding: 10px 20px !important;
            border-radius: 12px;
            transition: all 0.3s;
        }
        
        .nav-link:hover {
            background: rgba(255,255,255,0.2);
        }
        
        /* PREMIUM BUTTONS */
        .btn-primary {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            color: #ffffff;
            font-weight: 700;
            padding: 14px 35px;
            border-radius: 50px;
            border: none;
            box-shadow: 0 10px 30px rgba(215, 15, 100, 0.4);
            transition: all 0.4s;
        }
        
        .btn-primary:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px rgba(215, 15, 100, 0.5);
        }
        
        /* PREMIUM CARDS */
        .card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            transition: all 0.5s;
            background: #ffffff;
            overflow: hidden;
        }
        
        .card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 25px 60px rgba(215, 15, 100, 0.25);
        }
        
        .card-img-top {
            height: 240px;
            object-fit: cover;
            transition: transform 0.6s;
        }
        
        .card:hover .card-img-top {
            transform: scale(1.15);
        }
        
        .card-body { padding: 24px; }
        
        .card-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #212121;
        }
        
        .card-footer {
            background: linear-gradient(180deg, transparent 0%, rgba(215, 15, 100, 0.03) 100%);
            border-top: 2px solid #eeeeee;
            padding: 18px 24px;
        }
        
        /* PRICE TAG */
        .price-tag {
            font-size: 1.6rem;
            font-weight: 900;
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* BADGES */
        .badge {
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        
        .badge.bg-primary {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%) !important;
        }
        
        .badge.bg-secondary {
            background: linear-gradient(135deg, #616161 0%, #212121 100%) !important;
        }
        
        .badge.bg-success {
            background: linear-gradient(135deg, #00c853 0%, #00e676 100%) !important;
        }
        
        /* FILTER SECTION */
        .filter-section {
            background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
            padding: 30px;
            border-radius: 24px;
            margin-bottom: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }
        
        .form-control, .form-select {
            border: 3px solid #eeeeee;
            border-radius: 16px;
            padding: 16px 20px;
            transition: all 0.4s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #d70f64;
            box-shadow: 0 0 0 6px rgba(215, 15, 100, 0.15);
            outline: none;
        }
        
        /* TEXT GRADIENT */
        .text-gradient {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
        
        /* BUTTON GROUPS */
        .btn-outline-primary {
            border: 2px solid #d70f64;
            color: #d70f64;
            font-weight: 700;
        }
        
        .btn-outline-primary:hover {
            background: #d70f64;
            color: #ffffff;
        }
        
        .btn-outline-warning {
            border: 2px solid #ffc107;
            color: #212121;
            font-weight: 700;
        }
        
        .btn-outline-warning:hover {
            background: #ffc107;
        }
        
        .btn-outline-danger {
            border: 2px solid #f44336;
            color: #f44336;
            font-weight: 700;
        }
        
        .btn-outline-danger:hover {
            background: #f44336;
            color: #ffffff;
        }
        
        /* MODAL */
        .modal-content {
            border-radius: 24px;
            border: none;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        
        .modal-header {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            color: #ffffff;
            border-radius: 24px 24px 0 0;
            padding: 25px 30px;
        }
        
        /* FOOTER */
        footer {
            background: linear-gradient(135deg, #212121 0%, #1a1a1a 100%);
            color: #ffffff;
            padding: 60px 0 35px;
            margin-top: 100px;
        }
        
        footer strong {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
        
        /* ANIMATIONS */
        @keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-80px); }
            to { opacity: 1; transform: translateX(0); }
        }
        
        .animate-slide-left {
            animation: slideInLeft 0.8s ease-out;
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shop"></i> FoodHub
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(255,255,255,0.5);">
                <span class="navbar-toggler-icon" style="filter: brightness(0) invert(1);"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/menu-items"><i class="bi bi-grid"></i> Menu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/orders"><i class="bi bi-bag-check"></i> Orders</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="container mt-5 mb-5">
        <!-- Page Header -->
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-3 fw-bold text-gradient">Our Menu</h1>
                <p class="lead text-muted">Discover our delicious selection of food items</p>
            </div>
        </div>

        <!-- Action Bar -->
        <div class="row mb-4">
            <div class="col-md-8">
                <span class="badge bg-primary" style="font-size: 1rem; padding: 10px 20px;">
                    <i class="bi bi-grid"></i> <%= menuItems.length %> Items Available
                </span>
            </div>
            <div class="col-md-4 text-end">
                <a href="/menu-items/create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Add New Item
                </a>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">
                        <i class="bi bi-funnel"></i> Category
                    </label>
                    <select class="form-select" id="categoryFilter">
                        <option value="">All Categories</option>
                        <option value="appetizer">🥗 Appetizers</option>
                        <option value="main">🍕 Main Course</option>
                        <option value="dessert">🍰 Desserts</option>
                        <option value="beverage">🥤 Beverages</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        <i class="bi bi-search"></i> Search
                    </label>
                    <input type="text" class="form-control" id="searchInput" placeholder="Search for delicious food...">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">
                        <i class="bi bi-sort-down"></i> Sort By
                    </label>
                    <select class="form-select" id="sortSelect">
                        <option value="name-asc">Name (A-Z)</option>
                        <option value="name-desc">Name (Z-A)</option>
                        <option value="price-asc">Price (Low to High)</option>
                        <option value="price-desc">Price (High to Low)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Menu Items Grid -->
        <div class="row g-4" id="menuItemsGrid">
            <% if (menuItems.length === 0) { %>
            <div class="col-12">
                <div class="alert alert-info text-center p-5" style="border-radius: 20px;">
                    <i class="bi bi-info-circle" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">No menu items found</h4>
                    <p>Start by adding your first delicious item!</p>
                    <a href="/menu-items/create" class="btn btn-primary mt-3">
                        <i class="bi bi-plus-circle"></i> Add First Item
                    </a>
                </div>
            </div>
            <% } else { %>
                <% menuItems.forEach((item, index) => { %>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 animate-slide-left" 
                     style="animation-delay: <%= index * 0.05 %>s;"
                     data-category="<%= item.category %>" 
                     data-name="<%= item.name.toLowerCase() %>" 
                     data-price="<%= item.price %>">
                    <div class="card h-100">
                        <div style="position: relative;">
                            <img src="<%= item.image_url %>" class="card-img-top" alt="<%= item.name %>">
                            <% if (item.is_available) { %>
                                <span class="badge bg-success position-absolute top-0 end-0 m-3">
                                    <i class="bi bi-check-circle"></i> Available
                                </span>
                            <% } else { %>
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3">
                                    <i class="bi bi-x-circle"></i> Out of Stock
                                </span>
                            <% } %>
                        </div>
                        
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= item.name %></h5>
                            <p class="card-text text-muted small"><%= item.description %></p>
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-secondary">
                                        <% if (item.category === 'appetizer') { %>🥗
                                        <% } else if (item.category === 'main') { %>🍕
                                        <% } else if (item.category === 'dessert') { %>🍰
                                        <% } else { %>🥤<% } %>
                                        <%= item.category %>
                                    </span>
                                    <span class="price-tag">$<%= item.price.toFixed(2) %></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-footer bg-transparent">
                            <div class="d-grid gap-2 mb-2">
                                <a href="/orders/create?item=<%= item.id %>" class="btn btn-success">
                                    <i class="bi bi-cart-plus"></i> Order Now
                                </a>
                            </div>
                            <div class="btn-group w-100" role="group">
                                <a href="/menu-items/<%= item.id %>" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/menu-items/<%= item.id %>/edit" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteModal<%= item.id %>">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal<%= item.id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    <i class="bi bi-exclamation-triangle"></i> Confirm Delete
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: brightness(0) invert(1);"></button>
                            </div>
                            <div class="modal-body text-center p-4">
                                <i class="bi bi-trash" style="font-size: 4rem; color: #f44336;"></i>
                                <h5 class="mt-3">Are you sure?</h5>
                                <p class="text-muted">Do you really want to delete "<strong><%= item.name %></strong>"? This action cannot be undone.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                                <form action="/menu-items/<%= item.id %>?_method=DELETE" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container text-center">
            <p class="mb-2"><strong>FoodHub</strong> - Your Favorite Food Ordering Platform</p>
            <p class="mb-0">© 2024 Food Ordering System | Web Development Course Project</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Enhanced filtering
        document.getElementById('categoryFilter').addEventListener('change', filterItems);
        document.getElementById('searchInput').addEventListener('input', filterItems);

        function filterItems() {
            const category = document.getElementById('categoryFilter').value.toLowerCase();
            const search = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('#menuItemsGrid > div[data-category]');

            cards.forEach((card, index) => {
                const cardCategory = card.getAttribute('data-category').toLowerCase();
                const cardName = card.getAttribute('data-name').toLowerCase();
                
                const matchesCategory = !category || cardCategory === category;
                const matchesSearch = !search || cardName.includes(search);
                
                if (matchesCategory && matchesSearch) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
