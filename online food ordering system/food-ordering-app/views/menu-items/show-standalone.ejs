<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= item.name %> - FoodHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
            color: #212121;
        }
        .navbar {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            box-shadow: 0 8px 32px rgba(215, 15, 100, 0.25);
            padding: 18px 0;
        }
        .navbar-brand {
            font-size: 2rem;
            font-weight: 900;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        .navbar-brand i { color: #ffc107; font-size: 2.2rem; margin-right: 10px; }
        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            padding: 10px 20px !important;
            border-radius: 12px;
        }
        .nav-link:hover { background: rgba(255,255,255,0.2); }
        .btn-primary {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            color: #ffffff;
            font-weight: 700;
            padding: 14px 35px;
            border-radius: 50px;
            border: none;
            box-shadow: 0 10px 30px rgba(215, 15, 100, 0.4);
        }
        .btn-primary:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(215, 15, 100, 0.5);
        }
        .btn-outline-secondary {
            border: 2px solid #616161;
            color: #616161;
            font-weight: 700;
            padding: 14px 35px;
            border-radius: 50px;
        }
        .btn-outline-secondary:hover {
            background: #616161;
            color: #ffffff;
        }
        .card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            background: #ffffff;
            overflow: hidden;
        }
        .detail-image {
            width: 100%;
            height: 500px;
            object-fit: cover;
            border-radius: 24px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        }
        .price-tag {
            font-size: 3rem;
            font-weight: 900;
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .badge {
            padding: 10px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
        }
        .badge.bg-success {
            background: linear-gradient(135deg, #00c853 0%, #00e676 100%) !important;
        }
        .badge.bg-danger {
            background: linear-gradient(135deg, #f44336 0%, #ff5252 100%) !important;
        }
        .badge.bg-secondary {
            background: linear-gradient(135deg, #616161 0%, #212121 100%) !important;
        }
        .info-card {
            background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
            padding: 30px;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        footer {
            background: linear-gradient(135deg, #212121 0%, #1a1a1a 100%);
            color: #ffffff;
            padding: 60px 0 35px;
            margin-top: 100px;
        }
        footer strong {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="bi bi-shop"></i> FoodHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(255,255,255,0.5);">
                <span class="navbar-toggler-icon" style="filter: brightness(0) invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/menu-items"><i class="bi bi-grid"></i> Menu</a></li>
                    <li class="nav-item"><a class="nav-link" href="/orders"><i class="bi bi-bag-check"></i> Orders</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        <div class="row mb-4">
            <div class="col">
                <a href="/menu-items" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Menu
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-4">
                <img src="<%= item.image_url %>" alt="<%= item.name %>" class="detail-image">
            </div>
            
            <div class="col-lg-6">
                <div class="info-card">
                    <div class="mb-4">
                        <% if (item.is_available) { %>
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i> Available
                            </span>
                        <% } else { %>
                            <span class="badge bg-danger">
                                <i class="bi bi-x-circle"></i> Out of Stock
                            </span>
                        <% } %>
                        <span class="badge bg-secondary ms-2">
                            <% if (item.category === 'appetizer') { %>🥗
                            <% } else if (item.category === 'main') { %>🍕
                            <% } else if (item.category === 'dessert') { %>🍰
                            <% } else { %>🥤<% } %>
                            <%= item.category %>
                        </span>
                    </div>
                    
                    <h1 class="display-4 fw-bold mb-3"><%= item.name %></h1>
                    
                    <p class="lead text-muted mb-4"><%= item.description %></p>
                    
                    <div class="mb-4">
                        <div class="price-tag">$<%= item.price.toFixed(2) %></div>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="d-grid gap-3">
                        <a href="/orders/create?item=<%= item.id %>" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #00c853 0%, #00e676 100%); box-shadow: 0 10px 30px rgba(0, 200, 83, 0.4);">
                            <i class="bi bi-cart-plus"></i> Place Order
                        </a>
                        <a href="/menu-items/<%= item.id %>/edit" class="btn btn-primary btn-lg">
                            <i class="bi bi-pencil"></i> Edit Item
                        </a>
                        <button type="button" class="btn btn-outline-secondary btn-lg" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash"></i> Delete Item
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 24px;">
                <div class="modal-header" style="background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%); color: #ffffff; border-radius: 24px 24px 0 0;">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: brightness(0) invert(1);"></button>
                </div>
                <div class="modal-body text-center p-5">
                    <i class="bi bi-trash" style="font-size: 4rem; color: #f44336;"></i>
                    <h5 class="mt-3">Are you sure?</h5>
                    <p class="text-muted">Do you really want to delete "<strong><%= item.name %></strong>"? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/menu-items/<%= item.id %>?_method=DELETE" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <p class="mb-2"><strong>FoodHub</strong> - Your Favorite Food Ordering Platform</p>
            <p class="mb-0">© 2024 Food Ordering System | Web Development Course Project</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
