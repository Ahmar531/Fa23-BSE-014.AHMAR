<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - Delicious Food Delivered</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        /* FOODPANDA PREMIUM DESIGN */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
            color: #212121;
        }
        
        /* PINK GRADIENT NAVBAR */
        .navbar {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            box-shadow: 0 8px 32px rgba(215, 15, 100, 0.25);
            padding: 18px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .navbar-brand {
            font-size: 2rem;
            font-weight: 900;
            color: #ffffff !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
            transition: all 0.3s;
        }
        
        .navbar-brand:hover { transform: scale(1.08); }
        
        .navbar-brand i {
            color: #ffc107;
            font-size: 2.2rem;
            margin-right: 10px;
        }
        
        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            padding: 10px 20px !important;
            border-radius: 12px;
            transition: all 0.3s;
        }
        
        .nav-link:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-2px);
        }
        
        /* PREMIUM HERO */
        .hero-section {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 50%, #ff6b9d 100%);
            padding: 100px 0;
            color: #ffffff;
            position: relative;
            overflow: hidden;
        }
        
        .hero-section h1 {
            font-size: 4rem;
            font-weight: 900;
            margin-bottom: 24px;
            text-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        
        .hero-section .lead {
            font-size: 1.4rem;
            margin-bottom: 35px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        
        /* PREMIUM BUTTONS */
        .btn-primary {
            background: linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%);
            color: #d70f64;
            font-weight: 700;
            padding: 16px 40px;
            border-radius: 50px;
            border: none;
            box-shadow: 0 10px 30px rgba(215, 15, 100, 0.4);
            transition: all 0.4s;
        }
        
        .btn-primary:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px rgba(215, 15, 100, 0.5);
            color: #b00d52;
        }
        
        .btn-outline-light {
            border: 3px solid #ffffff;
            color: #ffffff;
            font-weight: 700;
            padding: 16px 40px;
            border-radius: 50px;
            background: transparent;
            transition: all 0.4s;
        }
        
        .btn-outline-light:hover {
            background: #ffffff;
            color: #d70f64;
            transform: translateY(-5px) scale(1.05);
        }
        
        /* PREMIUM CARDS */
        .card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            transition: all 0.5s;
            background: #ffffff;
            overflow: hidden;
        }
        
        .card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 25px 60px rgba(215, 15, 100, 0.25);
        }
        
        .card-img-top {
            height: 240px;
            object-fit: cover;
            transition: transform 0.6s;
        }
        
        .card:hover .card-img-top {
            transform: scale(1.15);
        }
        
        .card-body { padding: 24px; }
        
        .card-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #212121;
        }
        
        .card-text {
            font-size: 0.95rem;
            color: #616161;
        }
        
        .card-footer {
            background: linear-gradient(180deg, transparent 0%, rgba(215, 15, 100, 0.03) 100%);
            border-top: 2px solid #eeeeee;
            padding: 18px 24px;
        }
        
        /* PRICE TAG */
        .price-tag {
            font-size: 1.6rem;
            font-weight: 900;
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* BADGES */
        .badge {
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        
        .badge.bg-secondary {
            background: linear-gradient(135deg, #616161 0%, #212121 100%) !important;
        }
        
        /* FEATURE CARDS */
        .feature-card {
            background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
            padding: 50px 35px;
            border-radius: 24px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            transition: all 0.5s;
        }
        
        .feature-card:hover {
            transform: translateY(-15px) scale(1.03);
            box-shadow: 0 25px 60px rgba(215, 15, 100, 0.2);
        }
        
        .feature-card i {
            font-size: 4.5rem;
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 25px;
        }
        
        .feature-card h4 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 15px;
        }
        
        /* STAT CARDS */
        .stat-card {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            padding: 40px;
            border-radius: 24px;
            text-align: center;
            box-shadow: 0 15px 50px rgba(215, 15, 100, 0.35);
            transition: all 0.5s;
        }
        
        .stat-card:hover {
            transform: translateY(-10px) scale(1.05);
        }
        
        .stat-card h2 {
            font-size: 3rem;
            font-weight: 900;
            color: #ffffff;
            text-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        
        .stat-card p {
            color: rgba(255,255,255,0.95);
            font-weight: 600;
            margin: 0;
        }
        
        /* TEXT GRADIENT */
        .text-gradient {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
        
        /* FOOTER */
        footer {
            background: linear-gradient(135deg, #212121 0%, #1a1a1a 100%);
            color: #ffffff;
            padding: 60px 0 35px;
            margin-top: 100px;
        }
        
        footer strong {
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }
        
        /* ANIMATIONS */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-30px); }
        }
        
        @keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-80px); }
            to { opacity: 1; transform: translateX(0); }
        }
        
        .animate-slide-left {
            animation: slideInLeft 0.8s ease-out;
        }
        
        /* RESPONSIVE */
        @media (max-width: 768px) {
            .hero-section h1 { font-size: 2.3rem; }
            .card-img-top { height: 200px; }
        }
    </style>
</head>
<body>
    <!-- PINK GRADIENT NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shop"></i> FoodHub
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(255,255,255,0.5);">
                <span class="navbar-toggler-icon" style="filter: brightness(0) invert(1);"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/menu-items"><i class="bi bi-grid"></i> Menu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/orders"><i class="bi bi-bag-check"></i> Orders</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/api/menu-items" target="_blank">
                            <i class="bi bi-code-square"></i> API
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 text-center text-lg-start">
                    <h1>Delicious Food<br>Delivered to You</h1>
                    <p class="lead">Order your favorite meals from the comfort of your home. Fast delivery, fresh ingredients, amazing taste!</p>
                    <div class="mt-4">
                        <a href="/menu-items" class="btn btn-primary btn-lg me-3">
                            <i class="bi bi-grid"></i> Browse Menu
                        </a>
                        <a href="/orders/create" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-cart-plus"></i> Order Now
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 text-center mt-5 mt-lg-0">
                    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600&h=600&fit=crop" 
                         alt="Delicious Food" 
                         class="img-fluid rounded-circle shadow-lg" 
                         style="max-width: 500px; animation: float 3s ease-in-out infinite;">
                </div>
            </div>
        </div>
    </div>

    <!-- FEATURES SECTION -->
    <div class="container my-5 py-5">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold text-gradient">Why Choose FoodHub?</h2>
            <p class="lead text-muted">Experience the best food ordering service</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <h4>Fast Delivery</h4>
                    <p>Get your food delivered quickly with our efficient delivery system. Hot and fresh, right to your door!</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-star-fill"></i>
                    <h4>Quality Food</h4>
                    <p>We serve only the finest quality meals prepared by expert chefs using fresh ingredients.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-shield-check"></i>
                    <h4>Safe & Secure</h4>
                    <p>Your safety is our priority. Contactless delivery and secure payment options available.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- FEATURED ITEMS -->
    <div class="container my-5 py-5">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold">Featured Dishes</h2>
            <p class="lead text-muted">Try our most popular items</p>
        </div>
        
        <div class="row g-4">
            <% menuItems.slice(0, 4).forEach((item, index) => { %>
            <div class="col-12 col-sm-6 col-lg-3 animate-slide-left" style="animation-delay: <%= index * 0.1 %>s;">
                <div class="card">
                    <img src="<%= item.image_url %>" class="card-img-top" alt="<%= item.name %>">
                    <div class="card-body">
                        <h5 class="card-title"><%= item.name %></h5>
                        <p class="card-text"><%= item.description.substring(0, 60) %>...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary"><%= item.category %></span>
                            <span class="price-tag">$<%= item.price.toFixed(2) %></span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/menu-items/<%= item.id %>" class="btn btn-primary w-100">
                            <i class="bi bi-eye"></i> View Details
                        </a>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
        
        <div class="text-center mt-5">
            <a href="/menu-items" class="btn btn-primary btn-lg">
                <i class="bi bi-grid"></i> View Full Menu
            </a>
        </div>
    </div>

    <!-- STATISTICS -->
    <div class="container my-5 py-5">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2><%= menuItems.length %></h2>
                    <p>Menu Items</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>4</h2>
                    <p>Categories</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>500+</h2>
                    <p>Happy Customers</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <h2>4.8★</h2>
                    <p>Average Rating</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA SECTION -->
    <div class="container my-5 py-5">
        <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 30px;">
            <div class="card-body text-center text-white p-5">
                <h2 class="display-4 fw-bold mb-4">Ready to Order?</h2>
                <p class="lead mb-4">Join thousands of satisfied customers and enjoy delicious food delivered to your doorstep!</p>
                <a href="/menu-items" class="btn btn-light btn-lg me-3">
                    <i class="bi bi-grid"></i> Browse Menu
                </a>
                <a href="/orders/create" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-cart-plus"></i> Place Order
                </a>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container text-center">
            <p class="mb-2"><strong>FoodHub</strong> - Your Favorite Food Ordering Platform</p>
            <p class="mb-0">© 2024 Food Ordering System | Web Development Course Project</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
