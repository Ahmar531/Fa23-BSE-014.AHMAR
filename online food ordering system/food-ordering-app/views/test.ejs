<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Test - Foodpanda Style</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }
        
        /* PINK GRADIENT NAVBAR - FOODPANDA STYLE */
        .test-navbar {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 100%);
            padding: 20px 0;
            box-shadow: 0 8px 32px rgba(215, 15, 100, 0.25);
        }
        
        .test-navbar h1 {
            color: #ffffff;
            font-size: 2rem;
            font-weight: 900;
            margin: 0;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        
        .test-navbar .icon {
            color: #ffc107;
            font-size: 2.5rem;
            margin-right: 15px;
        }
        
        /* HERO SECTION */
        .test-hero {
            background: linear-gradient(135deg, #d70f64 0%, #ff1f7d 50%, #ff6b9d 100%);
            padding: 100px 0;
            color: #ffffff;
            text-align: center;
        }
        
        .test-hero h2 {
            font-size: 4rem;
            font-weight: 900;
            margin-bottom: 20px;
            text-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        
        .test-hero p {
            font-size: 1.5rem;
            margin-bottom: 30px;
        }
        
        /* PREMIUM BUTTON */
        .test-btn {
            background: linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%);
            color: #d70f64;
            font-weight: 700;
            padding: 16px 40px;
            border-radius: 50px;
            border: none;
            font-size: 1.2rem;
            box-shadow: 0 10px 30px rgba(215, 15, 100, 0.4);
            cursor: pointer;
            transition: all 0.4s;
        }
        
        .test-btn:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px rgba(215, 15, 100, 0.5);
        }
        
        /* CARD */
        .test-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 30px;
            margin: 30px auto;
            max-width: 400px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            transition: all 0.5s;
        }
        
        .test-card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 25px 60px rgba(215, 15, 100, 0.25);
        }
        
        .test-card h3 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #212121;
            margin-bottom: 15px;
        }
        
        .test-card .price {
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #d70f64 0%, #ff6b9d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .success-message {
            background: linear-gradient(135deg, #00c853 0%, #00e676 100%);
            color: #ffffff;
            padding: 20px;
            border-radius: 16px;
            margin: 30px auto;
            max-width: 600px;
            text-align: center;
            font-weight: 700;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <!-- TEST NAVBAR -->
    <div class="test-navbar">
        <div class="container">
            <div class="d-flex align-items-center">
                <i class="bi bi-shop icon"></i>
                <h1>FoodHub - Premium Design Test</h1>
            </div>
        </div>
    </div>
    
    <!-- TEST HERO -->
    <div class="test-hero">
        <div class="container">
            <h2>✨ Foodpanda Style Design ✨</h2>
            <p>Pink Gradient Navbar & Premium UI</p>
            <button class="test-btn">Order Now</button>
        </div>
    </div>
    
    <!-- SUCCESS MESSAGE -->
    <div class="success-message">
        ✅ If you can see PINK GRADIENT navbar above, the CSS is working!
    </div>
    
    <!-- TEST CARD -->
    <div class="test-card">
        <h3>🍕 Margherita Pizza</h3>
        <p>Fresh mozzarella, tomatoes, and basil on crispy crust</p>
        <div class="price">$12.99</div>
    </div>
    
    <div class="container text-center" style="padding: 50px 0;">
        <h3>CSS Test Results:</h3>
        <ul style="list-style: none; padding: 0; font-size: 1.1rem;">
            <li>✅ Pink Gradient Navbar (#d70f64 to #ff1f7d)</li>
            <li>✅ Premium White Button with Pink Text</li>
            <li>✅ 3D Hover Effects on Card</li>
            <li>✅ Gradient Price Tag</li>
            <li>✅ Smooth Animations</li>
        </ul>
        <br>
        <a href="/" class="btn btn-primary btn-lg">Go to Main Site</a>
    </div>
</body>
</html>
